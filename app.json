{
  "expo": {
    "name": "shotStopperCompanion",
    "slug": "shotStopperCompanion",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.icapurro.shotStopperCompanion",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to access network information.",
        "NSLocationAlwaysUsageDescription": "This app uses your location to access network information.",
        "NSBluetoothAlwaysUsageDescription": "Required to connect to the shotStopper device.",
        "NSBluetoothPeripheralUsageDescription": "Required to connect to the shotStopper device.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.icapurro.shotStopperCompanion",
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E9E7E0",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#111110"
          }
        }
      ],
      [
        "react-native-ble-manager",
        {
          "isBackgroundEnabled": true,
          "isBleRequired": true,
          "neverForLocation": true,
          "modes": [
            "peripheral",
            "central"
          ]
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Bluetooth"
          ],
          "podPermissions": [
            "Bluetooth"
          ]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep class * { *; }",
            "enableShrinkResources": false
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "fe4450c5-d8de-4b31-b5ba-3dd94fcac36a"
      }
    }
  }
}
